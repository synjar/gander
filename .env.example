# Gander — environment variables
#
# Copy this file to ".env" and fill in your Supabase project values.
# Find them in your Supabase dashboard:  Project Settings → API.
#
# Until these are set, Gander runs in DEMO mode: everything works in the
# browser (localStorage), with a guest account. Add the two values below to
# switch on real accounts and a real database.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
